{
  "name": "Mail Deck",
  "description": "__MSG_appDescription__",
  "author": "Nord Express",
  "version": "1.5.0",
  "manifest_version": 3,
  "default_locale": "en",
  "permissions": [
    "notifications",
    "contextMenus",
    "webRequest",
    "storage",
    "alarms",
    "idle",
    "offscreen",
    "cookies",
    "sidePanel",
    "declarativeNetRequestWithHostAccess",
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "optional_host_permissions": [
    "https://mail.yahoo.com/*",
    "https://mail.aol.com/*",
    "https://mail.proton.me/*",
    "https://mail.yandex.ru/*",
    "https://mail.360.yandex.ru/*",
    "https://api.passport.yandex.ru/*",
    "https://portal.mail.ru/*",
    "https://e.mail.ru/*",
    "https://api.openai.com/*",
    "https://auth.openai.com/*",
    "http://127.0.0.1/*",
    "https://api.anthropic.com/*",
    "https://api.z.ai/*"
  ],
  "action": {
    "default_icon": {
      "16": "/data/icons/blue/16.png",
      "18": "/data/icons/blue/18.png",
      "19": "/data/icons/blue/19.png",
      "32": "/data/icons/blue/32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["data/ai/callback.html", "data/ai/callback.js"],
      "matches": ["https://auth.openai.com/*", "https://chatgpt.com/*"]
    }
  ],
  "side_panel": {
    "default_path": "/data/panel/side.html"
  },
  "background": {
    "service_worker": "worker.js",
    "scripts": [
      "/core/utils/log.js",
      "/core/open.js",
      "/core/offscreen/firefox/polyfill.js",
      "/core/offscreen.js",
      "/core/services/yahoo.js",
      "/core/services/aol.js",
      "/core/services/proton.js",
      "/core/services/yandex.js",
      "/core/services/mailru.js",
      "/core/services.js",
      "/core/context.js",
      "/core/button.js",
      "/core/sound.js",
      "/core/utils/sax.js",
      "/core/utils/feed.js",
      "/core/utils/resolved.js",
      "/core/utils/remind.js",
      "/core/utils/quiet.js",
      "/core/check.js",
      "/core/repeater.js",
      "/core/watch.js",
      "/core/remind.js",
      "/core/avatars.js",
      "/worker.js"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    }
  },
  "options_ui": {
    "page": "/data/settings/index.html",
    "open_in_tab": true
  },
  "homepage_url": "https://nord-express.github.io/mail-deck/",
  "icons": {
    "16": "/data/icons/red/16.png",
    "18": "/data/icons/red/18.png",
    "19": "/data/icons/red/19.png",
    "32": "/data/icons/red/32.png",
    "48": "/data/icons/red/48.png",
    "64": "/data/icons/red/64.png",
    "128": "/data/icons/red/128.png"
  }
}
